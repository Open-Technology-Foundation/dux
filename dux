#!/usr/bin/env bash
# dux - Quick directory size overview (sorted smallest to largest)
set -euo pipefail
shopt -s inherit_errexit

# Lock down PATH for security
declare -rx PATH=/usr/local/bin:/usr/bin:/bin

declare -r VERSION=1.4.4
declare -r SCRIPT_NAME=${0##*/} # Script basename only

# Runtime flags
declare -i FOLLOW_SYMLINKS=0 VERBOSE=1

# Core message functions
_msg() { >&2 printf "$SCRIPT_NAME: $1 %s\n" "${@:2}"; }
# Future expansion:
#info() { ((VERBOSE)) || return 0; _msg '◉' "$@"; }
error() { _msg '✗' "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }

# --------------------------------------------------------------------------------
# Usage documentation
# --------------------------------------------------------------------------------
show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Quick directory size overview

Find out where your disk space is going. Shows the size of each subdirectory,
sorted smallest to largest (largest at bottom for easy viewing).

USAGE
  $SCRIPT_NAME [OPTIONS] [DIRECTORY]
  $SCRIPT_NAME -h | -V

OPTIONS
  -L             Follow symlinks
  -q, --quiet    Suppress permission errors
  -h, --help     Show this help
  -V, --version  Show version

EXAMPLES
  $SCRIPT_NAME              # Current directory
  $SCRIPT_NAME /var         # Check /var subdirectories
  $SCRIPT_NAME ~ | tail -5  # 5 largest in home directory
  sudo $SCRIPT_NAME /       # Full system (needs root)

OUTPUT
  <size>    <path>

  Sizes use IEC units (KiB, MiB, GiB). Tab-separated for easy parsing.
  Permission errors go to stderr; accessible content is still shown.

EXIT CODES
  0   Success
  2   Usage error (too many arguments)
  3   Directory not found
  5   I/O error (du failure)
  22  Invalid option

More info: https://github.com/Open-Technology-Foundation/dux
HELP
}

# --------------------------------------------------------------------------------
# Size each directory given as an argument, in parallel.
# Emits NUL-terminated "<bytes>\t<path>" records in completion order.
# --------------------------------------------------------------------------------
calc_sizes() {
  # One du per directory: a file hard-linked into several siblings counts in
  # full for each, where a single du over the whole tree would count it once.
  # du exits 1 on permission errors yet still emits a valid total (BCS0605);
  # xargs turns that into 123, so the caller validates the records instead.
  printf '%s\0' "$@" | xargs -0 -r -n1 -P"$(nproc)" du -sb -0 -- ||:
}

# --------------------------------------------------------------------------------
# Main function
# --------------------------------------------------------------------------------
main() {
  local -a dirs=() sizes=()
  local -A sized=()
  local -- dir='' current_dir record

  # Parse arguments
  while (($#)); do case $1 in
      -L)           FOLLOW_SYMLINKS=1 ;;
      -q|--quiet)   VERBOSE=0 ;;
      -h|--help)    show_help; exit 0 ;;
      -V|--version) printf '%s %s\n' "$SCRIPT_NAME" "$VERSION"; exit 0 ;;
      --)           shift
                    (($#)) || break
                    [[ -z $dir ]] || die 2 "Too many arguments ${1@Q}"
                    dir=$1
                    shift
                    (($# == 0)) || die 2 "Too many arguments ${1@Q}"
                    break ;;
      -[LqhV]?*)    set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;
      -*)           die 22 "Invalid option ${1@Q}" ;;
      *)            [[ -z $dir ]] || die 2 "Too many arguments ${1@Q}"
                    dir=$1 ;;
  esac; shift; done
  readonly -- FOLLOW_SYMLINKS VERBOSE

  # Default to current directory if no directory specified
  : "${dir:=./}"

  # Validate path is an existing directory
  [[ -d $dir ]] || die 3 "Not a directory ${dir@Q}"

  # find has no '--' for start points: a leading '-' is read as an expression
  # (BCS1005). A './' prefix makes the operand literal for find and du alike.
  [[ $dir != -* ]] || dir=./$dir

  # Collect target dir and immediate subdirectories (depth 0 + 1).
  # Stderr suppressed: permission errors on subtrees are non-fatal here.
  local -a find_opts=()
  #shellcheck disable=SC2015 # false positive
  ((FOLLOW_SYMLINKS)) && find_opts+=(-L) ||:
  #bcscheck disable=BCS1005 # find rejects '--'; $dir is './'-prefixed above
  readarray -d '' -t dirs < <(
    find "${find_opts[@]}" "$dir" -maxdepth 1 -type d -print0 2>/dev/null ||:)

  # Defensive: find should always emit at least $dir; empty result indicates
  # find failed entirely (e.g. dir vanished between -d check and exec).
  ((${#dirs[@]})) || die 3 "No directories found in ${dir@Q}"

  # -q silences du only; the script's own messages still reach stderr.
  if ((VERBOSE)); then
    readarray -d '' -t sizes < <(calc_sizes "${dirs[@]}")
  else
    readarray -d '' -t sizes < <(calc_sizes "${dirs[@]}" 2>/dev/null)
  fi

  # Every directory must come back with a record: du prints a total even
  # when it exits 1, so a missing record is a genuine failure.
  for record in "${sizes[@]}"; do
    sized[${record#*$'\t'}]=1
  done
  for current_dir in "${dirs[@]}"; do
    [[ -n ${sized[$current_dir]:-} ]] \
      || die 5 "Failed to calculate size for ${current_dir@Q}"
  done

  # Smallest first. One numfmt formats the whole stream; a fork per line
  # cost as much as the du calls themselves.
  printf '%s\0' "${sizes[@]}" \
    | sort -z -n \
    | numfmt -z -d $'\t' --field=1 --to=iec --suffix=B --format='%-10.1f' \
    | tr '\0' '\n'
}

main "$@"
#fin
